services:
  memorylocal:
    image: gnr092/memoryproxy:latest
    container_name: memoryproxy
    # El puerto 8888 no tiene autenticación: solo escucha en localhost.
    # Para entrar desde otro equipo, usa un túnel SSH:
    #   ssh -L 8888:localhost:8888 usuario@servidor
    ports:
      - "127.0.0.1:8888:8080"
    volumes:
      - ./memorydata:/data
    environment:
      - MEMORY_DB_PATH=/data/memory.db
      - TRANSFORMERS_CACHE=/data/.cache/transformers
    mem_limit: 1g
    memswap_limit: 1g
    restart: unless-stopped
