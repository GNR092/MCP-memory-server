services:
  memorylocal:
    image: gnr092/memoryproxy:latest
    container_name: memorylocal
    volumes:
      - ./memorydata:/data
    restart: unless-stopped
    networks:
      - traefik_network
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.memory.rule=Host(`example.gnr092hub.org`)"
      - "traefik.http.routers.memory.entrypoints=websecure"
      - "traefik.http.routers.memory.tls=true"
      - "traefik.http.routers.memory.tls.certresolver=letsencrypt"
      - "traefik.http.services.memory.loadbalancer.server.port=80"
      - "traefik.http.middlewares.auth.basicauth.users=USER:$$HASH_PLACEHOLDER"
      - "traefik.http.routers.memory.middlewares=auth"

networks:
  traefik_network:
    external: true
