#!/bin/bash
echo "================================================"
echo "  MCP Memory Server v${APP_VERSION:-0.0.0}"
echo "================================================"

trap 'kill -TERM $NGINX_PID $MCP_PID $GRAPH_PID 2>/dev/null; exit' SIGTERM SIGINT

# Si la DB trae vectores de otra dimensión (p. ej. bge-m3 1024 vs MiniLM 384),
# hace backup con fecha/hora y reconstruye obs_vec antes de arrancar.
echo "Verificando índice vectorial..."
if ! node /app/scripts/migrate-vectors.mjs; then
  echo "[ERROR] No se pudo verificar/migrar el índice vectorial. Abortando."
  exit 1
fi

nginx -g 'daemon off;' &
NGINX_PID=$!

# Graph-viewer: heap limitado a 96MB (solo sirve el grafo)
DB_PATH=/data/memory.db NODE_OPTIONS="--max-old-space-size=96" node /app/graph-viewer/server.js &
GRAPH_PID=$!

# mcp-proxy + memento: hereda NODE_OPTIONS del Dockerfile (256MB)
# --pass-environment para que memento reciba TRANSFORMERS_CACHE y demás env vars.
mcp-proxy --port 8945 --host 0.0.0.0 --pass-environment -- memento &
MCP_PID=$!

# Si muere cualquiera de los tres, el contenedor se cae y Docker lo reinicia.
wait -n
echo "[ERROR] Un proceso del servidor terminó. Reiniciando contenedor."
kill -TERM $NGINX_PID $MCP_PID $GRAPH_PID 2>/dev/null
exit 1
