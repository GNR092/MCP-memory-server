# =========================================
# MCP Memory Server - Environment Config
# =========================================
# Copy this file to .env and customize

# ---------- General ----------
NODE_ENV=production
HOST=0.0.0.0
PORT=3000

# ---------- MCP Transport ----------
# Endpoint for the Streamable HTTP transport (MCP spec 2025-06-18)
MCP_ENDPOINT=/mcp
# Session timeout in ms (default 1h)
MCP_SESSION_TIMEOUT_MS=3600000

# ---------- Graph Viewer ----------
GRAPH_ENABLED=true
DB_PATH=/data/memory.db
POLLING_INTERVAL=2000

# ---------- Security / OAuth 2.1 ----------
# Master toggle
AUTH_ENABLED=true

# OAuth issuer (public URL of this server)
AUTH_ISSUER=http://localhost:3000
# OAuth audience (resource identifier for RFC 8707)
AUTH_AUDIENCE=mcp-memory-server

# IMPORTANT: Generate a strong secret in production!
# openssl rand -hex 32
JWT_SECRET=change-me-please-use-32-bytes-of-random-data

# Token lifetimes (seconds)
ACCESS_TOKEN_TTL=3600      # 1 hour
REFRESH_TOKEN_TTL=604800   # 7 days

# Static tokens (comma-separated). For development or simple API key auth.
# In production, prefer the full OAuth 2.1 flow.
STATIC_TOKENS=

# Allowed CORS origins (comma-separated)
# Examples: https://app.example.com,https://admin.example.com
ALLOWED_ORIGINS=

# ---------- Rate Limiting ----------
RATE_LIMIT_WINDOW_MS=60000  # 1 minute
RATE_LIMIT_MAX=100          # requests per window per IP

# ---------- Logging ----------
LOG_LEVEL=info              # debug|info|warn|error
